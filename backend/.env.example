# Copy this file to backend/.env for local development.
# Never commit real credentials. Railway production values belong in the
# backend service's Variables page, not in this file.

SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/social_content_manager?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8081

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SSCM_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.*.*:5173,http://10.*.*.*:5173,http://172.*.*.*:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Optional locally. Production requires Cloudinary for durable media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional locally. Production Instagram publishing and Insights require these.
META_INSTAGRAM_USER_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v25.0

SSCM_PUBLISHING_PROVIDER=LOCAL
SSCM_PUBLISHING_SCHEDULING_ENABLED=true
